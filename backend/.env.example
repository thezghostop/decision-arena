# ============================================================
# Decision Arena Backend — Environment Variables
# Copy this to .env and fill in all values
# ============================================================

# ── App ──────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
PORT=8000

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-random-256-bit-hex

# ── Allowed Origins (comma-separated) ────────────────────────
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ── Clerk ────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# ── Supabase ─────────────────────────────────────────────────
# Use the SERVICE ROLE key (not the anon key) — needed for admin ops
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ_replace_service_role_key

# ── AI / LLM ─────────────────────────────────────────────────
# Provide at least one. The app tries providers in order: Groq → Ollama → Gemini → OpenAI
GROQ_API_KEY=gsk_replace_me           # Recommended — free tier, 500 tok/s
GEMINI_API_KEY=AI_replace_me          # Google Gemini 2.5 Flash — also powers the
                                       # Document Q&A ADK agent below (same key)
OPENAI_API_KEY=sk-replace_me          # Optional fallback

# Ollama (local inference — no API key needed, run debates fully offline)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5

PRIMARY_LLM=groq                      # groq | ollama | gemini | openai
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=1024

# ── Rate Limiting ─────────────────────────────────────────────
FREE_TIER_DAILY_LIMIT=3
MAX_PANEL_SIZE=6

# ── Redis (Phase 2 — optional) ────────────────────────────────
# REDIS_URL=redis://default:password@host:6379

# ── Document Q&A (PyMuPDF4LLM + Google ADK agent, Gemini-backed) ──
# Primary engine: a Google ADK Agent reads document sections via a tool and
# answers with Gemini. Requires GEMINI_API_KEY above — no separate key needed.
# Fallback (no GEMINI_API_KEY): runs fully offline via llama-cpp-python, once
# the GGUF model is downloaded. First request downloads the model (~8GB for
# the default 7B model) and caches it under ~/.cache/huggingface.
# Format: {hf_org}/{hf_repo}/{filename}
DOCUMENT_QA_MODEL=bartowski/Qwen2.5-7B-Instruct-GGUF/Qwen2.5-7B-Instruct-Q8_0.gguf
DOCUMENT_QA_MAX_SECTIONS=20
DOCUMENT_QA_STORAGE_DIR=./document_qa_storage
